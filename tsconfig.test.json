{
	// Bun tests import src/ directly; "herdr" is test/fake-herdr.ts at run time (test/preload.ts).
	"compilerOptions": {
		"target": "ESNext",
		"module": "Preserve",
		"moduleResolution": "bundler",
		"lib": ["ESNext"],
		"types": ["bun"],
		"allowImportingTsExtensions": true,
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"paths": {
			"herdr": ["./types/herdr.d.ts"]
		}
	},
	"include": ["test/**/*.ts", "types/gpui-kit.d.ts"]
}
