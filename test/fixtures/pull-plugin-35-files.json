[[{"sha":"a4749ce0038c9424af320bdabc41f73dfd3dfc16","filename":"docs/adr/0005-one-repository-renamed.md","status":"renamed","additions":0,"deletions":0,"changes":0,"blob_url":"https://github.com/lw396/herdr-plugin-github/blob/63f52f1dddd87eecbe02a9013523124921ee4345/docs%2Fadr%2F0005-one-repository-renamed.md","raw_url":"https://github.com/lw396/herdr-plugin-github/raw/63f52f1dddd87eecbe02a9013523124921ee4345/docs%2Fadr%2F0005-one-repository-renamed.md","contents_url":"https://api.github.com/repos/lw396/herdr-plugin-github/contents/docs%2Fadr%2F0005-one-repository-renamed.md?ref=63f52f1dddd87eecbe02a9013523124921ee4345","previous_filename":"docs/adr/0005-one-repository.md"}],[{"sha":"28c350ea49af8502288a29ddc89425f2661e1332","filename":"docs/adr/0006-poll-with-conditional-requests.md","status":"removed","additions":0,"deletions":5,"changes":5,"blob_url":"https://github.com/lw396/herdr-plugin-github/blob/fdcb50463daaa6921ed75bd45842c8eeb700833f/docs%2Fadr%2F0006-poll-with-conditional-requests.md","raw_url":"https://github.com/lw396/herdr-plugin-github/raw/fdcb50463daaa6921ed75bd45842c8eeb700833f/docs%2Fadr%2F0006-poll-with-conditional-requests.md","contents_url":"https://api.github.com/repos/lw396/herdr-plugin-github/contents/docs%2Fadr%2F0006-poll-with-conditional-requests.md?ref=fdcb50463daaa6921ed75bd45842c8eeb700833f","patch":"@@ -1,5 +0,0 @@\n-# 用条件请求轮询，不追求实时\n-\n-GitHub 网页的实时更新用的是 `alive.github.com` 上没有公开文档的 WebSocket，公开的推送只有 webhook，而 webhook 需要一个公网服务器来接收，GitHub mod 没有。\n-所以只能轮询：用带 ETag 的条件请求，没有变化时返回 304，不计入限额；只在看得见时轮询；搜索接口（每分钟 30 次，和这个账号所有用 gh 的地方共享）只在检测到变化后才调用。\n-代价是最多延迟一个轮询间隔。"}],[{"sha":"587e78420001f5dff67040f513736f9ba5571a5c","filename":"docs/pr-fixture.md","status":"added","additions":3,"deletions":0,"changes":3,"blob_url":"https://github.com/lw396/herdr-plugin-github/blob/63f52f1dddd87eecbe02a9013523124921ee4345/docs%2Fpr-fixture.md","raw_url":"https://github.com/lw396/herdr-plugin-github/raw/63f52f1dddd87eecbe02a9013523124921ee4345/docs%2Fpr-fixture.md","contents_url":"https://api.github.com/repos/lw396/herdr-plugin-github/contents/docs%2Fpr-fixture.md?ref=63f52f1dddd87eecbe02a9013523124921ee4345","patch":"@@ -0,0 +1,3 @@\n+# 测试用，可删\n+\n+A new file for PR fixtures."}],[{"sha":"e296330b19bbc94d51e3bf867d4ea2bbf5961caf","filename":"src/github/core/time.ts","status":"modified","additions":3,"deletions":0,"changes":3,"blob_url":"https://github.com/lw396/herdr-plugin-github/blob/63f52f1dddd87eecbe02a9013523124921ee4345/src%2Fgithub%2Fcore%2Ftime.ts","raw_url":"https://github.com/lw396/herdr-plugin-github/raw/63f52f1dddd87eecbe02a9013523124921ee4345/src%2Fgithub%2Fcore%2Ftime.ts","contents_url":"https://api.github.com/repos/lw396/herdr-plugin-github/contents/src%2Fgithub%2Fcore%2Ftime.ts?ref=63f52f1dddd87eecbe02a9013523124921ee4345","patch":"@@ -1,4 +1,5 @@\n // Times as the sidebar shows them.\n+// PR fixture: an added line near the top.\n \n const MINUTE = 60_000,\n \tHOUR = 60 * MINUTE,\n@@ -14,3 +15,5 @@ export function relativeTime(iso: string, now: number): string {\n \tif (ago < 365 * DAY) return `${Math.floor(ago / (30 * DAY))}mo`;\n \treturn `${Math.floor(ago / (365 * DAY))}y`;\n }\n+\n+// PR fixture: a line added at the end.\n\\ No newline at end of file"}]]